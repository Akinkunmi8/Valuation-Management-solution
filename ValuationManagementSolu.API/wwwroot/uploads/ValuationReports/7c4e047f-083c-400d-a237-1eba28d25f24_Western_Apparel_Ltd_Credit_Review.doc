<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'><head><title>Credit Review Report</title><style>
        body { font-family: 'Times New Roman', serif; color: #000000; line-height: 1.5; padding: 20px; }
        .text-center { text-align: center; }
        .text-end { text-align: right; }
        .fw-bold { font-weight: bold; }
        .text-primary { color: #0d6efd; }
        .bg-light { background-color: #f8f9fa; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 12px; }
        table, th, td { border: 1px solid #000000; }
        th, td { padding: 6px; vertical-align: middle; }
        th { background-color: #f1f1f1; font-weight: bold; }
        .section-title { font-weight: bold; font-size: 14px; text-transform: uppercase; border-bottom: 2px solid #333; margin-top: 25px; margin-bottom: 10px; padding-bottom: 3px; }
        .badge-success { color: #198754; font-weight: bold; }
        .badge-warning { color: #ffc107; font-weight: bold; }
        .badge-danger { color: #dc3545; font-weight: bold; }
    </style></head><body><div class='text-center' style='margin-bottom: 25px;'>
